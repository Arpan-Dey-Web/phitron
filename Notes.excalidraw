      "link": null,
      "locked": false,
      "text": "How to access Primary Diagonal? \nfirst have to run double loop ",
      "fontSize": 28,
      "fontFamily": 7,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "How to access Primary Diagonal? \nfirst have to run double loop ",
      "autoResize": true,
      "lineHeight": 1.15
    },
    {
      "id": "XMUHBb2sa87-gSSuL5zfT",
      "type": "text",
      "x": -853.6837383835806,
      "y": 6547.831982185849,
      "width": 518.562255859375,
      "height": 515.1999999999999,
      "angle": 0,
      "strokeColor": "#9c36b5",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bGH",
      "roundness": null,
      "seed": 1477698588,
      "version": 271,
      "versionNonce": 216154020,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1794846680665,
      "link": null,
      "locked": false,
      "text": "for (int i =0; i<n; i++\n{\n        for (int j=0; j<n; j++\n         {\n            if (i==j)\n            {\n               -> means i am on primary diagonal\n            }    \n            else if (i+j ==n-1)\n            {\n               -> means i am on secondary diagonal\n            }        \n\n          }\n\n}",
      "fontSize": 28,
      "fontFamily": 7,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "for (int i =0; i<n; i++\n{\n        for (int j=0; j<n; j++\n         {\n            if (i==j)\n            {\n               -> means i am on primary diagonal\n            }    \n            else if (i+j ==n-1)\n            {\n               -> means i am on secondary diagonal\n            }        \n\n          }\n\n}",
      "autoResize": true,
      "lineHeight": 1.15
    }
  ],
